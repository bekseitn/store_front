- if @order.errors.any? || @order_item.errors.any?
  = turbo_stream.prepend "flash_messages" do
    .alert.alert-dismissible.fade.show.alert-danger
      %button.btn-close{"aria-label" => t('common.close'), "data-bs-dismiss" => "alert", :type => "button"}
      = t('.error')
- else
  = turbo_stream.update "cart_text", render("layouts/cart_text")
