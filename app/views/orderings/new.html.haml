%h3.text-center= t('.title')
.row
  .col-md-6
    %h4.text-end
      = t('.total_label')
      = number_to_currency current_order.total
    - current_order.order_items.each do |oi|
      .card.mb-2
        .card-body
          .row
            .col-sm-7= oi.product.name
            .col-sm-2= t('.quantity', count: oi.quantity)
            .col-sm-3= number_to_currency oi.unit_price
  .col-md-6
    = form_with model: @ordering do |f|
      = f.hidden_field :order_id
      .row
        = f.group :name, class: "col-md-6" do
          = f.label :name, t('.name_label')
          = f.input :name
          = f.errors :name
        = f.group :phone, class: "col-md-6" do
          = f.label :phone, t('.phone_label')
          = f.input :phone
          = f.errors :phone
      = f.group :address do
        = f.label :address, t('.address_label')
        = f.input :address
        = f.errors :address
      = f.group :city do
        = f.label :city, t('.city_label')
        = f.input :city, include_blank: t('.city_placeholder')
        = f.errors :city
      .text-end= f.submit t('.submit_button'), class: 'btn btn-primary'
