!!!
%html
  %head
    %meta{:content => "text/html; charset=UTF-8", "http-equiv" => "Content-Type"}/
    %title Furniture
    = stylesheet_link_tag    'application', media: 'all', 'data-turbo-track' => 'reload'
    = stylesheet_link_tag 'https://maxcdn.bootstrapcdn.com/bootstrap/3.2.0/css/bootstrap.min.css'
    -# Bootstrap 3's own JS plugins (alert dismiss, dropdowns, modals) are
    -# jQuery plugins and can't run without it - dropped along with jQuery
    -# here. Nothing in this app currently uses a Bootstrap JS-driven
    -# component besides the alert's dismiss button, which just becomes a
    -# no-op until Stage C's Bootstrap 5.3 rewrite (vanilla JS, no jQuery).
    = csrf_meta_tags
    = javascript_importmap_tags
  %body
    .container
      .row
        .col-md-6
          %h1= link_to "Магазин", root_path
        .col-md-6.text-right
          %h1#cart_text.cart-text= render 'layouts/cart_text'
      %hr/
      #flash_messages
        - flash.each do |name, msg|
          - if msg.is_a?(String)
            %div{:class => "alert alert-#{name.to_s == 'notice' ? 'success' : 'danger'}"}
              %button.close{"aria-hidden" => "true", "data-dismiss" => "alert", :type => "button"} &times;
              = content_tag :div, msg, :id => "flash_#{name}"
      = yield
