!!!
%html
  %head
    %meta{:content => "text/html; charset=UTF-8", "http-equiv" => "Content-Type"}/
    %title Online Store
    = stylesheet_link_tag    'application', media: 'all', 'data-turbo-track' => 'reload'
    = stylesheet_link_tag 'https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css'
    -# Bootstrap 5's JS bundle includes Popper (needed for dropdowns/
    -# tooltips) and is plain JS - no jQuery dependency, unlike Bootstrap 3.
    = javascript_include_tag 'https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js'
    = csrf_meta_tags
    = javascript_importmap_tags
  %body
    .container
      .row
        .col-md-6
          %h1= link_to t('.shop_name'), root_path
        .col-md-6.text-end
          %h1#cart_text.cart-text= render 'layouts/cart_text'
      %hr/
      #flash_messages
        - flash.each do |name, msg|
          - if msg.is_a?(String)
            %div{:class => "alert alert-dismissible fade show alert-#{name.to_s == 'notice' ? 'success' : 'danger'}"}
              %button.btn-close{"aria-label" => t('common.close'), "data-bs-dismiss" => "alert", :type => "button"}
              = content_tag :div, msg, :id => "flash_#{name}"
      = yield
