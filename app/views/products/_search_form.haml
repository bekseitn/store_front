// Search form
.p-3.mb-3.bg-light.border.rounded
  = form_tag request.path, method: :get do
    .row
      .col-md-6
        = text_field_tag :search_query, params[:search_query], class: 'form-control',
        placeholder: t('.query_placeholder')
      .col-md-2
        = text_field_tag :with_price_gte, params[:with_price_gte], class: 'form-control',
        placeholder: t('.min_price_placeholder')
      .col-md-2
        = text_field_tag :with_price_lt, params[:with_price_lt], class: 'form-control',
        placeholder: t('.max_price_placeholder')
      .col-md-2
        = submit_tag t('.submit_button'), class: "btn btn-primary"
