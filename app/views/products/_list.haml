.d-flex.justify-content-between.align-items-center.p-2.mb-3.bg-light.border.rounded
  = t('.found_count', count: products.count)
  = link_to t('.reset_button'), request.path, class: "btn btn-secondary"

= will_paginate products, renderer: Bootstrap5PaginationRenderer

- products.each do |product|
  = render "products/product_row", product: product, order_item: @order_item

= will_paginate products, renderer: Bootstrap5PaginationRenderer
