.card.mb-3
  .card-body
    .row
      .col-md-2.text-center
        = image_tag product.picture_url(:thumb)
      .col-md-6
        %h4= product.name
      .col-md-4
        = form_with model: order_item do |f|
          %h4.text-end
            = t('.price_label')
            %span{:style => "color: green"}= number_to_currency order_item.unit_price
          .row
            .col-md-4
              = f.number_field :quantity, value: order_item.quantity.to_i, class: "form-control", min: 1
              = f.hidden_field :product_id, value: product.id
            .col-md-8.text-end
              .btn-group
                = f.submit t('.update_button'), class: "btn btn-primary"
                = link_to t('.delete_button'), order_item, { data: { turbo_confirm: t('.delete_confirm', name: order_item.product.name), turbo_method: :delete }, class: "btn btn-danger" }
          %h4.text-end
            = t('.total_label')
            %span{:style => "color: green"}= number_to_currency order_item.total_price
